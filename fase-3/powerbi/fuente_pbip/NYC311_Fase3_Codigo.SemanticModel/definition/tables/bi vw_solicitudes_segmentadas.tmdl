	column fecha = DATE('bi vw_solicitudes_segmentadas'[anio], 'bi vw_solicitudes_segmentadas'[mes], 1)
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: a38b8123-579c-48b4-82ab-001122334455
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column nombre_mes = FORMAT(DATE('bi vw_solicitudes_segmentadas'[anio], 'bi vw_solicitudes_segmentadas'[mes], 1), "MMMM")
		dataType: string
		lineageTag: 5c3d2e4f-6a7b-8c9d-0e1f-2a3b4c5d6e7f
		summarizeBy: none
		sortByColumn: mes

		annotation SummarizationSetBy = Automatic

	hierarchy 'Jerarquía de fechas'
		lineageTag: 6d4e3f5a-7b8c-9d0e-1f2a-3b4c5d6e7f8a

		level Año
			lineageTag: 7e5f4a6b-8c9d-0e1f-2a3b-4c5d6e7f8a9b
			column: anio

		level Mes
			lineageTag: 8f6a5b7c-9d0e-1f2a-3b4c-5d6e7f8a9b0c
			column: nombre_mes

	measure 'Solicitudes distintas' = COALESCE(DISTINCTCOUNT('bi vw_solicitudes_segmentadas'[codigo_solicitud]), 0)
		formatString: #,##0

	measure 'Solicitudes con tiempo' = COALESCE(CALCULATE([Solicitudes distintas], NOT ISBLANK('bi vw_solicitudes_segmentadas'[minutos_resolucion])), 0)
		formatString: #,##0

	measure 'Solicitudes sin duración' = COALESCE(CALCULATE([Solicitudes distintas], ISBLANK('bi vw_solicitudes_segmentadas'[minutos_resolucion])), 0)
		formatString: #,##0

	measure 'Solicitudes con demora alta' = COALESCE(CALCULATE([Solicitudes distintas], 'bi vw_solicitudes_segmentadas'[demora_alta] = 1), 0)
		formatString: #,##0

	measure 'Tasa demora alta' = DIVIDE([Solicitudes con demora alta], [Solicitudes con tiempo], 0.0)
		formatString: 0.0%

	measure 'Mediana minutos observados' = MEDIAN('bi vw_solicitudes_segmentadas'[minutos_resolucion])
		formatString: #,##0

	measure 'Solicitudes segmentadas' = COALESCE(CALCULATE([Solicitudes distintas], 'bi vw_solicitudes_segmentadas'[es_segmentado] = TRUE), 0)
		formatString: #,##0

	measure 'Solicitudes fuera de perfil' = COALESCE(CALCULATE([Solicitudes distintas], 'bi vw_solicitudes_segmentadas'[es_segmentado] = FALSE), 0)
		formatString: #,##0

	measure 'Porcentaje segmentado' = DIVIDE([Solicitudes segmentadas], [Solicitudes distintas], 0.0)
		formatString: 0.0%

	partition 'bi vw_solicitudes_segmentadas' = m
		mode: import
		source =
				let
				    Origen = Sql.Database("localhost", "DW_NYC311"),
				    bi_vw_solicitudes_segmentadas = Origen{[Schema="bi",Item="vw_solicitudes_segmentadas"]}[Data]
				in
				    bi_vw_solicitudes_segmentadas

	annotation PBI_ResultType = Table

