      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E434DC1-317A-47BD-9453-38B10F97D23F}"
          SQLTask:SqlStatementSource="UPDATE etl.Ejecucion&#xA;SET&#xA;    fin = SYSDATETIME(),&#xA;&#xA;    filas_extraidas = (&#xA;        SELECT COUNT(*)&#xA;        FROM raw.Solicitud&#xA;        WHERE run_id = ?&#xA;    ),&#xA;&#xA;    filas_validas = (&#xA;        SELECT COUNT(*)&#xA;        FROM stg.Solicitud&#xA;        WHERE run_id = ?&#xA;    ),&#xA;&#xA;    filas_rechazadas = (&#xA;        SELECT COUNT(*)&#xA;        FROM raw.Solicitud&#xA;        WHERE run_id = ?&#xA;    )&#xA;    -&#xA;    (&#xA;        SELECT COUNT(*)&#xA;        FROM stg.Solicitud&#xA;        WHERE run_id = ?&#xA;    ),&#xA;&#xA;    estado = 'SUCCESS',&#xA;&#xA;    detalle = 'ETL completado correctamente: RAW -&gt; STG -&gt; DW'&#xA;&#xA;WHERE run_id = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::RunId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="36" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::RunId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="36" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::RunId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="36" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::RunId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="36" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::RunId"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="36" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
