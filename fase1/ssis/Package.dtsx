    <DTS:Executable
      DTS:refId="Package\DIMENSION FECHA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{16BE7C6D-E3C3-4180-A7EC-8C72FA6094EB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIMENSION FECHA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E434DC1-317A-47BD-9453-38B10F97D23F}"
          SQLTask:SqlStatementSource="/* =========================================================&#xA;   CARGAR DIM FECHA&#xA;   Fuente: created_date + closed_date&#xA;   fecha_key = YYYYMMDD&#xA;   ========================================================= */&#xA;&#xA;WITH Fechas AS (&#xA;    SELECT CAST(created_date AS DATE) AS fecha&#xA;    FROM stg.Solicitud&#xA;&#xA;    UNION&#xA;&#xA;    SELECT CAST(closed_date AS DATE)&#xA;    FROM stg.Solicitud&#xA;    WHERE closed_date IS NOT NULL&#xA;)&#xA;INSERT INTO dw.DimFecha (&#xA;    fecha_key,&#xA;    fecha,&#xA;    anio,&#xA;    trimestre,&#xA;    mes,&#xA;    nombre_mes,&#xA;    dia,&#xA;    dia_semana,&#xA;    nombre_dia&#xA;)&#xA;SELECT&#xA;    CONVERT(INT, CONVERT(CHAR(8), f.fecha, 112)) AS fecha_key,&#xA;    f.fecha,&#xA;    YEAR(f.fecha) AS anio,&#xA;    DATEPART(QUARTER, f.fecha) AS trimestre,&#xA;    MONTH(f.fecha) AS mes,&#xA;    DATENAME(MONTH, f.fecha) AS nombre_mes,&#xA;    DAY(f.fecha) AS dia,&#xA;    DATEPART(WEEKDAY, f.fecha) AS dia_semana,&#xA;    DATENAME(WEEKDAY, f.fecha) AS nombre_dia&#xA;FROM Fechas f&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.DimFecha d&#xA;    WHERE d.fecha = f.fecha&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DIMENSIONES FALTANTES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{5799D732-65DA-4010-A525-9049311C06C0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIMENSIONES FALTANTES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E434DC1-317A-47BD-9453-38B10F97D23F}"
          SQLTask:SqlStatementSource="/* =========================================================&#xA;   DIM PROBLEMA&#xA;   ========================================================= */&#xA;INSERT INTO dw.DimProblema (&#xA;    complaint_type,&#xA;    descriptor,&#xA;    descriptor_2&#xA;)&#xA;SELECT DISTINCT&#xA;    s.complaint_type,&#xA;    s.descriptor,&#xA;    s.descriptor_2&#xA;FROM stg.Solicitud s&#xA;WHERE s.complaint_type IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;      SELECT 1&#xA;      FROM dw.DimProblema d&#xA;      WHERE d.complaint_type = s.complaint_type&#xA;        AND ISNULL(d.descriptor, '') = ISNULL(s.descriptor, '')&#xA;        AND ISNULL(d.descriptor_2, '') = ISNULL(s.descriptor_2, '')&#xA;  );&#xA;&#xA;&#xA;/* =========================================================&#xA;   DIM GEOGRAFIA&#xA;   ========================================================= */&#xA;INSERT INTO dw.DimGeografia (&#xA;    borough,&#xA;    incident_zip,&#xA;    community_board,&#xA;    council_district,&#xA;    police_precinct&#xA;)&#xA;SELECT DISTINCT&#xA;    s.borough,&#xA;    s.incident_zip,&#xA;    s.community_board,&#xA;    s.council_district,&#xA;    s.police_precinct&#xA;FROM stg.Solicitud s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.DimGeografia d&#xA;    WHERE ISNULL(d.borough, '') = ISNULL(s.borough, '')&#xA;      AND ISNULL(d.incident_zip, '') = ISNULL(s.incident_zip, '')&#xA;      AND ISNULL(d.community_board, '') = ISNULL(s.community_board, '')&#xA;      AND ISNULL(d.council_district, -1) = ISNULL(s.council_district, -1)&#xA;      AND ISNULL(d.police_precinct, '') = ISNULL(s.police_precinct, '')&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\DIMENSIONES SIMPLES"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{FCE45E84-EE26-4BE7-9E3F-7A9E1583DE49}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIMENSIONES SIMPLES"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4E434DC1-317A-47BD-9453-38B10F97D23F}"
          SQLTask:SqlStatementSource="/* =========================&#xA;   DIM ESTADO&#xA;   ========================= */&#xA;INSERT INTO dw.DimEstado (status)&#xA;SELECT DISTINCT s.status&#xA;FROM stg.Solicitud s&#xA;WHERE s.status IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;      SELECT 1&#xA;      FROM dw.DimEstado d&#xA;      WHERE d.status = s.status&#xA;  );&#xA;&#xA;&#xA;/* =========================&#xA;   DIM CANAL&#xA;   ========================= */&#xA;INSERT INTO dw.DimCanal (open_data_channel_type)&#xA;SELECT DISTINCT s.open_data_channel_type&#xA;FROM stg.Solicitud s&#xA;WHERE s.open_data_channel_type IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;      SELECT 1&#xA;      FROM dw.DimCanal d&#xA;      WHERE d.open_data_channel_type = s.open_data_channel_type&#xA;  );&#xA;&#xA;&#xA;/* =========================&#xA;   DIM AGENCIA&#xA;   ========================= */&#xA;INSERT INTO dw.DimAgencia (&#xA;    agency,&#xA;    agency_name&#xA;)&#xA;SELECT DISTINCT&#xA;    s.agency,&#xA;    s.agency_name&#xA;FROM stg.Solicitud s&#xA;WHERE s.agency IS NOT NULL&#xA;  AND NOT EXISTS (&#xA;      SELECT 1&#xA;      FROM dw.DimAgencia d&#xA;      WHERE d.agency = s.agency&#xA;  );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\EXTRAER"
      DTS:CreationName="Microsoft.Pipeline"
      DTS:Description="Data Flow Task"
      DTS:DTSID="{5B5F1F37-1AA2-4F72-B4E2-A8C486A55B3B}"
      DTS:ExecutableType="Microsoft.Pipeline"
      DTS:LocaleID="-1"
      DTS:ObjectName="EXTRAER"
      DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
      <DTS:Variables />
      <DTS:ObjectData>
        <pipeline
          version="1">
          <components>
            <component
              refId="Package\EXTRAER\Componente de script"
              componentClassID="Microsoft.ManagedComponentHost"
              contactInfo="Incluye y ejecuta código de scripts personalizados. Por ejemplo, se usa para aplicar una regla de negocios que limita el intervalo de valores válidos de una columna de ingresos o para sumar los valores de dos columnas y calcular el promedio de la suma.;Microsoft Corporation; Microsoft SQL Server; Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;14"
              description="Incluye y ejecuta código de scripts personalizados. Por ejemplo, se usa para aplicar una regla de negocios que limita el intervalo de valores válidos de una columna de ingresos o para sumar los valores de dos columnas y calcular el promedio de la suma."
              name="Componente de script"
              version="14">
              <properties>
                <property
                  dataType="System.String"
                  description="Almacena el código fuente del componente"
                  isArray="true"
                  name="SourceCode"
                  state="cdata">
                  <arrayElements
                    arrayElementCount="30">
                    <arrayElement
                      dataType="System.String"><![CDATA[main.cs]]></arrayElement>
                    <arrayElement
                      dataType="System.String"><![CDATA[UTF8]]></arrayElement>
                    <arrayElement
                      dataType="System.String"><![CDATA[#region Namespaces

using System;
using System.Collections.Generic;
using System.IO;
using System.Net;
using System.Net.Http;
using System.Runtime.Serialization.Json;
using System.Text;
using System.Threading;
using System.Threading.Tasks;

using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;

#endregion


[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    private const int PageSize = 10000;
    private const int MaxRetries = 3;

    private string GetString(
        Dictionary<string, object> item,
        string key)
    {
        if (!item.ContainsKey(key))
            return "";

        if (item[key] == null)
            return "";

        return item[key].ToString();
    }


    public override void CreateNewOutputRows()
    {
        try
        {
            ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
            DateTime startFrom = Variables.StartFrom;
            DateTime endAt = Variables.EndAt;

            int offset = 0;
            bool hasMoreRows = true;

            using (HttpClient client = new HttpClient())
            {
                client.Timeout = TimeSpan.FromSeconds(60);

                while (hasMoreRows)
                {
                    string url = BuildUrl(
                        startFrom,
                        endAt,
                        PageSize,
                        offset
                    );

                    List<Dictionary<string, object>> rows =
                        GetPageWithRetry(client, url);
                    foreach (var item in rows)
                    {
                        Salida0Buffer.AddRow();

                        Salida0Buffer.runid =
                            new Guid(Variables.RunId);

                        Salida0Buffer.uniquekey =
                            GetString(item, "unique_key");

                        Salida0Buffer.createddate =
                            GetString(item, "created_date");

                        Salida0Buffer.closeddate =
                            GetString(item, "closed_date");

                        Salida0Buffer.resolutionactionupdateddate =
                            GetString(item, "resolution_action_updated_date");

                        Salida0Buffer.duedate =
                            GetString(item, "due_date");

                        Salida0Buffer.agency =
                            GetString(item, "agency");

                        Salida0Buffer.agencyname =
                            GetString(item, "agency_name");

                        Salida0Buffer.complainttype =
                            GetString(item, "complaint_type");

                        Salida0Buffer.descriptor =
                            GetString(item, "descriptor");

                        Salida0Buffer.descriptor2 =
                            GetString(item, "descriptor_2");

                        Salida0Buffer.locationtype =
                            GetString(item, "location_type");

                        Salida0Buffer.status =
                            GetString(item, "status");

                        Salida0Buffer.resolutiondescription =
                            GetString(item, "resolution_description");

                        Salida0Buffer.borough =
                            GetString(item, "borough");

                        Salida0Buffer.incidentzip =
                            GetString(item, "incident_zip");

                        Salida0Buffer.incidentaddress =
                            GetString(item, "incident_address");

                        Salida0Buffer.communityboard =
                            GetString(item, "community_board");

                        Salida0Buffer.councildistrict =
                            GetString(item, "council_district");

                        Salida0Buffer.policeprecinct =
                            GetString(item, "police_precinct");

                        Salida0Buffer.latitude =
                            GetString(item, "latitude");

                        Salida0Buffer.longitude =
                            GetString(item, "longitude");

                        Salida0Buffer.bbl =
                            GetString(item, "bbl");

                        Salida0Buffer.opendatachanneltype =
                            GetString(item, "open_data_channel_type");
                    }
                    /*
                     * Si la API devuelve menos de PageSize,
                     * significa que llegamos a la última página.
                     */
                    if (rows.Count < PageSize)
                    {
                        hasMoreRows = false;
                    }
                    else
                    {
                        offset += PageSize;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            bool cancel;

            ComponentMetaData.FireError(
                0,
                "NYC311 API Source",
                ex.ToString(),
                "",
                0,
                out cancel
            );

            throw;
        }
    }


    private string BuildUrl(
        DateTime startFrom,
        DateTime endAt,
        int limit,
        int offset)
    {
        string start =
            startFrom.ToString("yyyy-MM-dd'T'HH:mm:ss");

        string end =
            endAt.ToString("yyyy-MM-dd'T'HH:mm:ss");

        string select =
            "unique_key," +
            "created_date," +
            "closed_date," +
            "resolution_action_updated_date," +
            "due_date," +
            "agency," +
            "agency_name," +
            "complaint_type," +
            "descriptor," +
            "descriptor_2," +
            "location_type," +
            "status," +
            "resolution_description," +
            "borough," +
            "incident_zip," +
            "incident_address," +
            "community_board," +
            "council_district," +
            "police_precinct," +
            "latitude," +
            "longitude," +
            "bbl," +
            "open_data_channel_type";

        string where =
            "created_date >= '" + start + "'" +
            " AND created_date < '" + end + "'";

        string order =
            "created_date ASC, unique_key ASC";

        string url =
            "https://data.cityofnewyork.us/resource/erm2-nwe9.json" +
            "?$select=" + Uri.EscapeDataString(select) +
            "&$where=" + Uri.EscapeDataString(where) +
            "&$order=" + Uri.EscapeDataString(order) +
            "&$limit=" + limit +
            "&$offset=" + offset;

        return url;
    }


    private List<Dictionary<string, object>> GetPageWithRetry(
    HttpClient client,
    string url)
    {
        Exception lastException = null;

        for (int attempt = 1; attempt <= MaxRetries; attempt++)
        {
            try
            {
                HttpResponseMessage response =
                    client.GetAsync(url).Result;

                string body =
                    response.Content
                        .ReadAsStringAsync()
                        .Result;

                int statusCode = (int)response.StatusCode;

                // 200-299
                if (response.IsSuccessStatusCode)
                {
                    return DeserializeRows(body);
                }

                // Error temporal: sí reintentamos
                if (statusCode == 429 || statusCode >= 500)
                {
                    string temporaryError =
                        "NYC311 API - error temporal" +
                        Environment.NewLine +
                        "Intento: " + attempt + "/" + MaxRetries +
                        Environment.NewLine +
                        "HTTP: " + statusCode +
                        " " + response.ReasonPhrase +
                        Environment.NewLine +
                        "URL: " + url +
                        Environment.NewLine +
                        "Respuesta: " + body;

                    LogError(temporaryError);

                    if (attempt < MaxRetries)
                    {
                        Thread.Sleep(
                            GetRetryDelayMilliseconds(attempt)
                        );

                        continue;
                    }

                    throw new Exception(temporaryError);
                }

                // 400, 401, 403, 404...
                // NO tiene sentido reintentarlos.
                string permanentError =
                    "NYC311 API - error HTTP no reintentable" +
                    Environment.NewLine +
                    "HTTP: " + statusCode +
                    " " + response.ReasonPhrase +
                    Environment.NewLine +
                    "URL: " + url +
                    Environment.NewLine +
                    "Respuesta de Socrata:" +
                    Environment.NewLine +
                    body;

                LogError(permanentError);

                throw new Exception(permanentError);
            }
            catch (AggregateException ex)
            {
                Exception realException = ex.GetBaseException();

                lastException = realException;

                string error =
                    "NYC311 API - excepción de conexión" +
                    Environment.NewLine +
                    "Intento: " + attempt + "/" + MaxRetries +
                    Environment.NewLine +
                    "URL: " + url +
                    Environment.NewLine +
                    "Tipo: " + realException.GetType().FullName +
                    Environment.NewLine +
                    "Mensaje: " + realException.Message;

                LogError(error);

                if (attempt < MaxRetries)
                {
                    Thread.Sleep(
                        GetRetryDelayMilliseconds(attempt)
                    );

                    continue;
                }
            }
        }

        string finalError =
            "NYC311 API - extracción abortada" +
            Environment.NewLine +
            "Se agotaron los " + MaxRetries + " intentos." +
            Environment.NewLine +
            "URL: " + url +
            Environment.NewLine +
            "Último error: " +
            (lastException != null
                ? lastException.ToString()
                : "Sin excepción disponible.");

        LogError(finalError);

        throw new Exception(
            finalError,
            lastException
        );
    }


    private int GetRetryDelayMilliseconds(int attempt)
    {
        /*
         * 2s, 4s, 8s
         */
        return 2000 * (int)Math.Pow(2, attempt - 1);
    }


    private List<Dictionary<string, object>> DeserializeRows(
        string json)
    {
        var settings =
            new DataContractJsonSerializerSettings
            {
                UseSimpleDictionaryFormat = true
            };

        var serializer =
            new DataContractJsonSerializer(
                typeof(List<Dictionary<string, object>>),
                settings
            );

        using (
            MemoryStream stream =
                new MemoryStream(
                    Encoding.UTF8.GetBytes(json)
                )
        )
        {
            return
                (List<Dictionary<string, object>>)
                serializer.ReadObject(stream);
        }
    }

    private void LogError(string message)
    {
        try
        {
            string folder = Variables.LogDirectory;

            if (string.IsNullOrWhiteSpace(folder))
                return;

            Directory.CreateDirectory(folder);

            string file = Path.Combine(
                folder,
                "nyc311_etl_" +
                DateTime.Now.ToString("yyyyMMdd") +
                ".log"
            );

            File.AppendAllText(
                file,
                DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") +
                Environment.NewLine +
                message +
                Environment.NewLine +
                "--------------------------------------------------" +
                Environment.NewLine
            );
        }
        catch
        {
            // El log nunca debe esconder el error real del ETL.
        }
    }
}]]></arrayElement>
