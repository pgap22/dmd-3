          SQLTask:SqlStatementSource="MERGE dw.FactSolicitud AS target&#xA;USING (&#xA;    SELECT&#xA;        s.unique_key AS codigo_solicitud,&#xA;&#xA;        fc.fecha_key AS fecha_creacion_key,&#xA;        fcl.fecha_key AS fecha_cierre_key,&#xA;&#xA;        a.agencia_key,&#xA;        p.problema_key,&#xA;        g.geografia_key,&#xA;        e.estado_key,&#xA;        c.canal_key,&#xA;&#xA;        CASE&#xA;            WHEN s.status = 'Closed'&#xA;             AND s.closed_date IS NOT NULL&#xA;             AND s.closed_date &gt;= s.created_date&#xA;            THEN DATEDIFF(MINUTE, s.created_date, s.closed_date)&#xA;            ELSE NULL&#xA;        END AS minutos_resolucion,&#xA;&#xA;        s.latitude,&#xA;        s.longitude&#xA;&#xA;    FROM stg.Solicitud s&#xA;&#xA;    INNER JOIN dw.DimFecha fc&#xA;        ON fc.fecha = CAST(s.created_date AS DATE)&#xA;&#xA;    LEFT JOIN dw.DimFecha fcl&#xA;        ON fcl.fecha = CAST(s.closed_date AS DATE)&#xA;&#xA;    INNER JOIN dw.DimAgencia a&#xA;        ON a.agency = s.agency&#xA;&#xA;    INNER JOIN dw.DimProblema p&#xA;        ON p.complaint_type = s.complaint_type&#xA;       AND ISNULL(p.descriptor, '') = ISNULL(s.descriptor, '')&#xA;       AND ISNULL(p.descriptor_2, '') = ISNULL(s.descriptor_2, '')&#xA;&#xA;    LEFT JOIN dw.DimGeografia g&#xA;        ON ISNULL(g.borough, '') = ISNULL(s.borough, '')&#xA;       AND ISNULL(g.incident_zip, '') = ISNULL(s.incident_zip, '')&#xA;       AND ISNULL(g.community_board, '') = ISNULL(s.community_board, '')&#xA;       AND ISNULL(g.council_district, -1) = ISNULL(s.council_district, -1)&#xA;       AND ISNULL(g.police_precinct, '') = ISNULL(s.police_precinct, '')&#xA;&#xA;    INNER JOIN dw.DimEstado e&#xA;        ON e.status = s.status&#xA;&#xA;    LEFT JOIN dw.DimCanal c&#xA;        ON c.open_data_channel_type = s.open_data_channel_type&#xA;) AS source&#xA;&#xA;ON target.codigo_solicitud = source.codigo_solicitud&#xA;&#xA;WHEN MATCHED THEN&#xA;    UPDATE SET&#xA;        target.fecha_creacion_key = source.fecha_creacion_key,&#xA;        target.fecha_cierre_key = source.fecha_cierre_key,&#xA;        target.agencia_key = source.agencia_key,&#xA;        target.problema_key = source.problema_key,&#xA;        target.geografia_key = source.geografia_key,&#xA;        target.estado_key = source.estado_key,&#xA;        target.canal_key = source.canal_key,&#xA;        target.minutos_resolucion = source.minutos_resolucion,&#xA;        target.latitude = source.latitude,&#xA;        target.longitude = source.longitude&#xA;&#xA;WHEN NOT MATCHED THEN&#xA;    INSERT (&#xA;        codigo_solicitud,&#xA;        fecha_creacion_key,&#xA;        fecha_cierre_key,&#xA;        agencia_key,&#xA;        problema_key,&#xA;        geografia_key,&#xA;        estado_key,&#xA;        canal_key,&#xA;        minutos_resolucion,&#xA;        latitude,&#xA;        longitude&#xA;    )&#xA;    VALUES (&#xA;        source.codigo_solicitud,&#xA;        source.fecha_creacion_key,&#xA;        source.fecha_cierre_key,&#xA;        source.agencia_key,&#xA;        source.problema_key,&#xA;        source.geografia_key,&#xA;        source.estado_key,&#xA;        source.canal_key,&#xA;        source.minutos_resolucion,&#xA;        source.latitude,&#xA;        source.longitude&#xA;    );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
